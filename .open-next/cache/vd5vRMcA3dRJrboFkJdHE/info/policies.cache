\"/_next/static/chunks/ff5c593683f61d5a.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Policies | LMCollection</title><meta name=\"description\" content=\"LMCollection - Like it, Love it, &amp; Wear it.\"/><link rel=\"icon\" href=\"/icon.png?icon.9f521e2c.png\" sizes=\"430x430\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?apple-icon.6c01afe0.png\" sizes=\"180x180\" type=\"image/png\"/><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable antialiased flex flex-col min-h-screen\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"bg-stone-950\"><section class=\"flex justify-center-safe items-center-safe\"><div class=\"flex justify-between items-center-safe px-5 w-full md:w-[80%]\"><i class=\"hidden md:block\"><svg stroke=\"white\" fill=\"white\" stroke-width=\"0\" viewBox=\"0 0 24 24\" class=\"hover:cursor-pointer\" height=\"2em\" width=\"2em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10 18a7.952 7.952 0 0 0 4.897-1.688l4.396 4.396 1.414-1.414-4.396-4.396A7.952 7.952 0 0 0 18 10c0-4.411-3.589-8-8-8s-8 3.589-8 8 3.589 8 8 8zm0-14c3.309 0 6 2.691 6 6s-2.691 6-6 6-6-2.691-6-6 2.691-6 6-6z\"></path></svg></i><i class=\"md:hidden\"><svg stroke=\"white\" fill=\"white\" stroke-width=\"0\" viewBox=\"0 0 24 24\" class=\"hover:cursor-pointer\" height=\"2em\" width=\"2em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z\"></path></svg></i><a class=\"relative\" href=\"/\"><img alt=\"lmcollection-logo\" loading=\"lazy\" width=\"100\" height=\"100\" decoding=\"async\" data-nimg=\"1\" class=\"size-15 md:size-20\" style=\"color:transparent\" src=\"/_next/static/media/Liphiwe_business_logo_white.42cbc2f6.svg\"/></a><a class=\"relative\" href=\"/cart\"><svg stroke=\"white\" fill=\"white\" stroke-width=\"0\" viewBox=\"0 0 24 24\" class=\"hover:cursor-pointer\" height=\"2em\" width=\"2em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M5 22h14c1.103 0 2-.897 2-2V9a1 1 0 0 0-1-1h-3V7c0-2.757-2.243-5-5-5S7 4.243 7 7v1H4a1 1 0 0 0-1 1v11c0 1.103.897 2 2 2zM9 7c0-1.654 1.346-3 3-3s3 1.346 3 3v1H9V7zm-4 3h2v2h2v-2h6v2h2v-2h2l.002 10H5V10z\"></path></svg></a></div></section><section class=\"flex fixed z-10 w-full h-full transition-all delay-100 -translate-x-full\"><div class=\"backdrop-blur-sm w-full h-full fixed z-4 transition-all delay-75 duration-25 -translate-x-full\"></div><nav class=\"md:hidden flex flex-col space-y-3 py-4 px-5 w-[70%] md:w-[50%] bg-stone-200 h-full z-5 transition-all duration-100 -translate-x-full\"><a class=\"font-semibold text-shadow-stone-950\" href=\"/\">Home</a><a class=\"font-semibold text-shadow-stone-950\" href=\"/collection/products/all\">Catalog</a><a class=\"font-semibold text-shadow-stone-950\" href=\"/info/about\">About</a><a class=\"font-semibold text-shadow-stone-950\" href=\"/info/contact\">Contact store</a></nav></section></div><nav class=\"hidden md:flex sticky top-0 z-3 bg-white w-full py-1 justify-center-safe space-x-5\"><a class=\"font-semibold text-stone-600 false hover:underline hover:underline-offset-3\" href=\"/\">Home</a><a class=\"font-semibold text-stone-600 false hover:underline hover:underline-offset-3\" href=\"/collection/products/all\">Catalog</a><a class=\"font-semibold text-stone-600 text-stone-950 underline decoration-2 underline-offset-2 false\" href=\"/info/policies\">Policies</a><a class=\"font-semibold text-stone-600 false hover:underline hover:underline-offset-3\" href=\"/info/about\">About</a><a class=\"font-semibold text-stone-600 false hover:underline hover:underline-offset-3\" href=\"/info/contact\">Contact store</a></nav><main class=\"flex-1 space-y-3 py-5 px-2 md:px-10 xl:w-[70%] xl:px-0 xl:place-self-center-safe\"><h1 class=\"text-4xl font-bold text-stone-900 text-center\">Policy - LM Collection</h1><div class=\"text-justify space-y-3\"><p class=\"text-justify flex place-self-center mx-auto max-w-4xl sm:text-center\">At LM Collection, we want you to be completely satisfied with your purchase. Much appreciation for shopping at LM COLLECTION. We are committed to providing you with fast and reliable shipping.</p><p class=\"text-center border-y border-stone-700 mx-5 py-3 font-semibold\">FOR SHIPPING, WE ONLY USE PEP PAXI AND THE COURIER GUY COURIER SERVICES.</p> <p>Here are our<!-- --> <span class=\"font-semibold italic\">shipping, returns, &amp; refund</span> <!-- -->policies; please read our policy below:</p></div><section id=\"shipping\" class=\"space-y-3 md:py-8\"><h2 class=\"text-2xl font-bold text-stone-700\">Shipping</h2><div class=\"border-collapse\"><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Processing time:</p><div class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\"><ol class=\"list-disc list-inside\"><li>Orders are typically processed within 14 business days of being placed. This includes order verification, packing, and shipping preparation.</li><li>Please note that processing times may vary slightly depending on the volume of orders and immediate availability of stock.</li></ol></div></section><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Delivery time:</p><p class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\">Once your order has shipped, delivery typically takes 3 to 5 working days within South Africa.</p></section><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Tracking Information:</p><div class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\"><ol class=\"list-disc list-inside\"><li>You will receive a tracking number via SMS once your order has shipped.</li><li>You can use the tracking number to monitor the status of your order on PEP PAXI COURIER Website.<br/><span class=\"before:content-[&#x27;*&#x27;] before:text-red-500 before:mr-0.5\">Once your order has arrived you will get an sms for collection at your nearest PEP STORE.</span></li></ol></div></section><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Shipping Address:</p><p class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\">Please ensure that your shipping address is correct and complete when placing your order.</p></section><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Shipping Delays:</p><div class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\"><ol class=\"list-disc list-inside\"><li>While we strive to deliver your order on time, unforeseen circumstances such as weather conditions, carrier delays, or holidays may cause delays.</li><li>We will keep you updated on any shipping delays and provide you with the latest information.</li></ol></div></section></div></section><section id=\"returns\" class=\"space-y-5 md:py-8\"><h2 class=\"text-2xl font-bold text-stone-700\">Returns</h2><div class=\"border-collapse\"><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Eligibilty:</p><p class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\">Returns are accepted within <em>3 days</em> of receiving your order. Items must be in the same condition you received them — unworn, unused, with tags, and in the original packaging.</p></section><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Process:</p><div class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\"><ol class=\"list-decimal list-inside\"><li>Contact us at<!-- --> <a href=\"mailto:lmcollection4412@gmail.com\"><em class=\"font-semibold text-stone-800 underline underline-offset-2\">lmcollection4412@gmail.com</em></a> <!-- -->to request a return.</li><li>If approved, we will provide instructions on how and where to send your package.</li><li>Items sent back without prior approval will not be accepted.</li></ol></div></section><section class=\"table-row\"><p class=\"table-cell border border-stone-600 p-1 font-semibold text-stone-500 xl:p-3\">Cost:</p><p class=\"table-cell border border-stone-600 p-1 px-2 xl:p-3\">Customers are responsible for return shipping costs unless the item is defective, damaged, or the wrong product was sent. Exchanges will also be at the customer&#x27;s cost.</p></section></div><div class=\"flex overflow-auto space-x-2 print:flex-col print:space-y-3 xl:pr-1 min-w-full\"><article class=\"border border-stone-700 rounded-xl p-2 space-y-3 text-sm min-w-full lg:min-w-[50%]\"><h3 class=\"text-left font-semibold text-stone-700 border-b border-stone-500 pb-2 ps-4\">Non-returnable Items</h3><div class=\"ps-4\">The following cannot be returned:<ol class=\"list-disc list-inside\"><li>Sale items or digital products</li><li>Perishable goods (e.g., food, flowers, plants)</li><li>Custom or personalized products Personal care items (e.g., beauty products)</li><li>Hazardous materials, flammable liquids, or gases</li></ol></div></article><article class=\"border border-stone-700 rounded-xl p-2 space-y-3 text-sm min-w-full lg:min-w-[47%]\"><h3 class=\"text-left font-semibold text-stone-700 border-b border-stone-500 pb-2 ps-4\">Damages &amp; Issues</h3><p class=\"ps-4\">Please inspect your order upon delivery and contact us immediately if it is defective, damaged, or incorrect. We will evaluate the issue and work to resolve it promptly.</p></article></div><p class=\"before:content-[&#x27;*&#x27;] before:text-red-500 italic text-sm\">If you are unsure about your item, please contact us for clarification.</p></section><section id=\"refunds\" class=\"space-y-3 md:py-8\"><h2 class=\"text-2xl font-bold text-stone-700\">Refunds</h2><div><ol class=\"list-disc list-inside ps-3\"><li>Refunds are only issued if we are unable to fulfill your order within 14 working days of purchase.</li><li>If approved, your refund will be processed by our payment provider and returned to your original payment method within 3 business days.</li><li>For customers unhappy with their order (but where the item was correctly fulfilled), only exchanges are offered after inspection.</li></ol></div></section><section id=\"contact\" class=\"space-y-3 md:py-8 place-items-center\"><h2 class=\"text-2xl font-bold text-stone-700\">Contact</h2><div><p class=\"text-center\">For any return, refund, or exchange inquiries, please reach out to us at<!-- --> <a href=\"mailto:lmcollection4412@gmail.com\"><em class=\"font-semibold text-stone-800 underline underline-offset-2\">lmcollection4412@gmail.com</em></a>.</p></div></section></main><!--$--><!--/$--><footer class=\"bg-stone-950 w-full\"><div class=\"flex p-10 justify-evenly\"><a class=\"hidden md:flex footer-logo size-30 items-center-safe\" href=\"/\"><img alt=\"footer-logo\" loading=\"lazy\" width=\"500\" height=\"500\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/_next/static/media/Liphiwe_business_logo_white.42cbc2f6.svg\"/></a><div class=\"flex flex-col\"><p class=\"text-white font-semibold\">Quick links</p><a class=\"text-stone-400\" href=\"/\">Home</a><a class=\"text-stone-400\" href=\"/collection/products/all\">Catalog</a><a class=\"text-stone-400\" href=\"/info/about\">About</a><a class=\"text-stone-400\" href=\"/info/contact\">Contact store</a></div><div><div class=\"flex flex-col\"><a class=\"text-white font-semibold\" href=\"/info/policies\">Policies</a><a class=\"text-stone-400\" href=\"/info/policies#shipping\">Shipping</a><a class=\"text-stone-400\" href=\"/info/policies#returns\">Returns</a><a class=\"text-stone-400\" href=\"/info/policies#refunds\">Refunds</a><a class=\"text-stone-400\" href=\"/info/policies#contact\">Contact</a></div></div></div><div class=\"items-center text-center text-stone-400 py-2 borde